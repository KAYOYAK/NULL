{
  "name": "chat-demo",
  "version": "0.1.1",
  "description": "基于 DeepSeek API 的静态聊天示例。",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "type": "module",
  "scripts": {
    "dev": "rspack serve -c rspack.config.ts",
    "build": "rm -rf dist && NODE_ENV=production rspack build -c rspack.config.ts",
    "type": "tsc -p tsconfig.json",
    "lint": "oxlint src rspack.config.ts",
    "format": "oxfmt --write .",
    "build:local": "node scripts/build-local.mjs"
  },
  "dependencies": {
    "@types/katex": "^0.16.8",
    "@types/mdast": "~4.0.4",
    "@types/prismjs": "^1.26.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "idb": "8.0.4",
    "katex": "0.19.1",
    "mdast-util-find-and-replace": "3.0.4",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "12.3.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-llm-math": "3.1.1-20250610",
    "prismjs": "1.30.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@rspack/cli": "2.3.3",
    "@rspack/core": "2.3.3",
    "@rspack/dev-server": "2.2.2",
    "@swc/helpers": "0.5.24",
    "@types/node": "~26.6.6",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "typescript": "7.0.2"
  }
}
